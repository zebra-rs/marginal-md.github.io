---
// Overrides Starlight's ThemeSelect with the marketing site's sun/moon
// toggle. Starlight renders it twice (header and mobile menu), so the
// click handler is delegated. See ThemeProvider.astro for the storage key.
---

<button class="theme-toggle" type="button" aria-label="Switch theme">
	<svg
		class="moon"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
	>
	<svg
		class="sun"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		><circle cx="12" cy="12" r="4"></circle><path
			d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path></svg
	>
</button>

<script>
	const current = (): 'light' | 'dark' =>
		document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

	function label(): void {
		const text = `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`;
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
			button.setAttribute('aria-label', text);
			button.title = text;
		});
	}

	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		if (!target?.closest?.('.theme-toggle')) return;
		const next = current() === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {
			/* storage unavailable: the choice lasts for this page only */
		}
		label();
	});

	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
	label();
</script>
