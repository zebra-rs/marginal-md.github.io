{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-fg",
      "--active-bg",
      "--bg",
      "--border",
      "--chrome-bg",
      "--error",
      "--fg",
      "--hover-bg",
      "--muted",
      "--selection-bg",
      "--success",
      "--warning"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--fg": "color",
      "--muted": "color",
      "--chrome-bg": "color",
      "--border": "color",
      "--hover-bg": "color",
      "--active-bg": "color",
      "--accent": "color",
      "--accent-fg": "color",
      "--selection-bg": "color",
      "--error": "color",
      "--warning": "color",
      "--success": "color"
    },
    "fontFamilies": []
  }
}